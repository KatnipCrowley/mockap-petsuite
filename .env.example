# URL pública del API compartido cuando exista (sin barra final).
# Sin esta variable PetSuite usa el servidor mock del navegador.
VITE_API_URL=

# Base de datos PostgreSQL (Supabase desde Vercel). Ver backend/db/README.md.
# Pega aquí el snippet de Vercel > Storage > pet-suite-dat > .env.local y define estas dos con sus valores,
# cambiando sslmode=require por sslmode=no-verify. Nunca subas el archivo .env: contiene la contraseña de la base.
# Valor de POSTGRES_URL (pooler en modo transacción, puerto 6543), para el API:
DATABASE_URL=
# Valor de POSTGRES_URL_NON_POOLING (pooler en modo sesión, puerto 5432), para migraciones y seed:
DATABASE_URL_UNPOOLED=

# Correo real con Resend (terminal del API). Sin estas dos variables los correos quedan solo en la bandeja simulada.
# MAIL_FROM debe usar un dominio verificado en Resend, por ejemplo: PetSuite <no-responder@tudominio.cl>
# RESEND_API_KEY=
# MAIL_FROM=
# Dirección de la app que abren los enlaces de confirmación, recuperación e invitación (con barra final):
# APP_URL=https://TU_USUARIO.github.io/mockap-petsuite/

# Backend compartido (terminal del API):
# PETSUITE_CORS_ORIGINS=http://localhost:5173,https://TU_USUARIO.github.io
# PETSUITE_DATA_FILE=./data/petsuite.json
# HOST=0.0.0.0 y PETSUITE_ALLOW_DEMO_API=1 habilitan explícitamente la API demo en la red.
