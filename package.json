{
  "name": "petsuite-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:start": "node --env-file-if-exists=.env backend/server.mjs",
    "test": "node --test src/modules/admin/admin-suspension.test.mjs src/modules/business/business.test.mjs src/modules/business/business-rules.test.mjs backend/server.test.mjs backend/api/servidor.test.mjs backend/api/paridad.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env backend/db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env backend/db/seed.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
